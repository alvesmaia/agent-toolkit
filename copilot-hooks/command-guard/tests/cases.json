[
  { "name": "git status", "tool": "powershell", "args": { "command": "git status" }, "expect": "allow" },
  { "name": "python version", "tool": "powershell", "args": { "command": "python --version" }, "expect": "allow" },
  { "name": "winget install uv", "tool": "powershell", "args": { "command": "winget install --id astral-sh.uv" }, "expect": "allow" },
  { "name": "download without execution", "tool": "powershell", "args": { "command": "Invoke-WebRequest -Uri https://example.com/a.ps1 -OutFile $env:TEMP\\a.ps1" }, "expect": "allow" },
  { "name": "Write-Host mentions blocked cmdlet", "tool": "powershell", "args": { "command": "Write-Host \"Set-MpPreference is blocked\"" }, "expect": "allow" },
  { "name": "comment mentions blocked cmdlet", "tool": "powershell", "args": { "command": "Write-Output 1 # Set-MpPreference" }, "expect": "allow" },
  { "name": "encoding parameter is not -e", "tool": "powershell", "args": { "command": "powershell -Command \"Out-File -Encoding utf8 out.txt\"" }, "expect": "allow" },
  { "name": "Get-Content of missing script is not execution", "tool": "powershell", "args": { "command": "Get-Content missing.ps1" }, "expect": "allow" },
  { "name": "good local script", "tool": "powershell", "args": { "command": ".\\good.ps1" }, "cwd": "{FIXTURES}", "expect": "allow" },
  { "name": "good local bat", "tool": "powershell", "args": { "command": "call good.bat" }, "cwd": "{FIXTURES}", "expect": "allow" },
  { "name": "python subprocess git allowed", "tool": "powershell", "args": { "command": "python \"good.py\"" }, "cwd": "{FIXTURES}", "expect": "allow" },
  { "name": "python -c subprocess git allowed", "tool": "powershell", "args": { "command": "python -c \"import subprocess; subprocess.run(['git','status'])\"" }, "expect": "allow" },
  { "name": "apply_patch plain ps1", "tool": "apply_patch", "args": "*** Begin Patch\n*** Add File: C:/tmp/a.ps1\n+Write-Output 'hi'\n*** End Patch", "expect": "allow" },
  { "name": "apply_patch markdown mention ignored", "tool": "apply_patch", "args": "*** Begin Patch\n*** Add File: notes.md\n+Set-MpPreference -DisableRealtimeMonitoring $true\n*** End Patch", "expect": "allow" },
  { "name": "apply_patch ps1 comment only", "tool": "apply_patch", "args": "*** Begin Patch\n*** Add File: C:/tmp/a.ps1\n+# Set-MpPreference example\n*** End Patch", "expect": "allow" },
  { "name": "apply_patch python git allowed", "tool": "apply_patch", "args": "*** Begin Patch\n*** Add File: C:/tmp/x.py\n+import subprocess\n+subprocess.run(['git','status'])\n*** End Patch", "expect": "allow" },
  { "name": "other tool allowed", "tool": "view", "args": { "path": "x" }, "expect": "allow" },

  { "name": "execution policy bypass", "tool": "powershell", "args": { "command": "powershell -ExecutionPolicy Bypass -Command \"Write-Output 1\"" }, "expect": "deny", "reason": "execution-policy" },
  { "name": "ep abbreviation", "tool": "powershell", "args": { "command": "pwsh -ep bypass -c 1" }, "expect": "deny", "reason": "execution-policy" },
  { "name": "ex abbreviation with colon", "tool": "powershell", "args": { "command": "powershell -ex:Bypass -c 1" }, "expect": "deny", "reason": "execution-policy" },
  { "name": "unrestricted", "tool": "powershell", "args": { "command": "powershell -ExecutionPolicy Unrestricted -Command 1" }, "expect": "deny", "reason": "execution-policy" },
  { "name": "Set-ExecutionPolicy bypass", "tool": "powershell", "args": { "command": "Set-ExecutionPolicy Bypass -Scope Process" }, "expect": "deny", "reason": "execution-policy" },
  { "name": "EncodedCommand", "tool": "powershell", "args": { "command": "powershell -EncodedCommand ZQBjAGgAbwAgADEA" }, "expect": "deny", "reason": "encoded-command" },
  { "name": "-enc abbreviation", "tool": "powershell", "args": { "command": "pwsh -enc ZQBjAGgAbwA=" }, "expect": "deny", "reason": "encoded-command" },
  { "name": "-e abbreviation", "tool": "powershell", "args": { "command": "powershell -e ZQBjAGgAbwA=" }, "expect": "deny", "reason": "encoded-command" },
  { "name": "Set-MpPreference", "tool": "powershell", "args": { "command": "Set-MpPreference -DisableRealtimeMonitoring $true" }, "expect": "deny", "reason": "defender-tamper" },
  { "name": "Set-MpPreference inside -Command", "tool": "powershell", "args": { "command": "powershell -Command \"Set-MpPreference -DisableRealtimeMonitoring 1\"" }, "expect": "deny", "reason": "defender-tamper" },
  { "name": "Add-MpPreference exclusion", "tool": "powershell", "args": { "command": "Add-MpPreference -ExclusionPath C:\\x" }, "expect": "deny", "reason": "defender-tamper" },
